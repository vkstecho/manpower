rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    /**
     * Profile photos — path: profilePhotos/{uidOrMobile}/avatar.jpg
     * - Any signed-in user can read (avatars shown in team UI)
     * - Write only if authenticated; path folder should match their phone/uid
     * - Max ~5MB; images only
     */
    match /profilePhotos/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (
          // Phone auth: token phone ends with userId (10-digit) or equals +91userId
          (request.auth.token.phone_number != null
            && (
              request.auth.token.phone_number.matches('.*' + userId + '$')
              || userId == request.auth.uid
            )
          )
          // Or folder is auth uid
          || userId == request.auth.uid
        );

      allow delete: if request.auth != null
        && (
          userId == request.auth.uid
          || (request.auth.token.phone_number != null
              && request.auth.token.phone_number.matches('.*' + userId + '$'))
        );
    }

    /**
     * Login / registration selfies — path: selfies/{...}
     */
    match /selfies/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    /**
     * Report photos (NCR etc.)
     */
    match /reportPhotos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
